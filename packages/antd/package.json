{
  "name": "@axisj/beautiful-grid-antd",
  "version": "0.1.0",
  "description": "Ant Design editor integrations for BeautifulGrid.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axisj/beautiful-grid-plugins.git",
    "directory": "packages/antd"
  },
  "homepage": "https://github.com/axisj/beautiful-grid-plugins/tree/main/packages/antd#readme",
  "bugs": {
    "url": "https://github.com/axisj/beautiful-grid-plugins/issues"
  },
  "keywords": [
    "beautiful-grid",
    "antd",
    "ant-design",
    "react",
    "data-grid",
    "editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "antd": ">=5 <7",
    "beautiful-grid": ">=1 <2",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  }
}
