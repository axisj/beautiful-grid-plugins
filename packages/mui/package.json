{
  "name": "@beautifuljs/grid-mui",
  "version": "0.1.0",
  "description": "Material UI editor integrations for BeautifulGrid.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axisj/beautiful-grid-plugins.git",
    "directory": "packages/mui"
  },
  "homepage": "https://github.com/axisj/beautiful-grid-plugins/tree/main/packages/mui#readme",
  "bugs": {
    "url": "https://github.com/axisj/beautiful-grid-plugins/issues"
  },
  "keywords": [
    "beautiful-grid",
    "mui",
    "material-ui",
    "react",
    "data-grid",
    "editor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "@emotion/react": ">=11 <12",
    "@emotion/styled": ">=11 <12",
    "@mui/material": ">=9 <10",
    "@mui/x-date-pickers": ">=9 <10",
    "beautiful-grid": ">=1 <2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "dependencies": {
    "dayjs": "^1.11.18"
  }
}
