{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "beautiful-grid-shadcn",
  "homepage": "https://bgrid.axisj.com",
  "items": [
    {
      "name": "beautiful-grid-editors",
      "type": "registry:component",
      "title": "BeautifulGrid Shadcn Editors",
      "description": "Select, date, color, cascader, time, and tree-select editors for BeautifulGrid.",
      "dependencies": [
        "@radix-ui/react-popover",
        "beautiful-grid",
        "lucide-react"
      ],
      "files": [
        {
          "path": "beautiful-grid-editors/editor-popover.tsx",
          "type": "registry:component",
          "target": "components/beautiful-grid/editor-popover.tsx"
        },
        {
          "path": "beautiful-grid-editors/shared.tsx",
          "type": "registry:component",
          "target": "components/beautiful-grid/shared.tsx"
        },
        {
          "path": "beautiful-grid-editors/createShadcnSelectEditorPlugin.tsx",
          "type": "registry:component",
          "target": "components/beautiful-grid/createShadcnSelectEditorPlugin.tsx"
        },
        {
          "path": "beautiful-grid-editors/createShadcnDatePickerEditorPlugin.tsx",
          "type": "registry:component",
          "target": "components/beautiful-grid/createShadcnDatePickerEditorPlugin.tsx"
        },
        {
          "path": "beautiful-grid-editors/createShadcnColorPickerEditorPlugin.tsx",
          "type": "registry:component",
          "target": "components/beautiful-grid/createShadcnColorPickerEditorPlugin.tsx"
        },
        {
          "path": "beautiful-grid-editors/createShadcnCascaderEditorPlugin.tsx",
          "type": "registry:component",
          "target": "components/beautiful-grid/createShadcnCascaderEditorPlugin.tsx"
        },
        {
          "path": "beautiful-grid-editors/createShadcnTimePickerEditorPlugin.tsx",
          "type": "registry:component",
          "target": "components/beautiful-grid/createShadcnTimePickerEditorPlugin.tsx"
        },
        {
          "path": "beautiful-grid-editors/createShadcnTreeSelectEditorPlugin.tsx",
          "type": "registry:component",
          "target": "components/beautiful-grid/createShadcnTreeSelectEditorPlugin.tsx"
        },
        {
          "path": "beautiful-grid-editors/editorUtils.ts",
          "type": "registry:component",
          "target": "components/beautiful-grid/editorUtils.ts"
        },
        {
          "path": "beautiful-grid-editors/index.ts",
          "type": "registry:component",
          "target": "components/beautiful-grid/index.ts"
        },
        {
          "path": "beautiful-grid-editors/beautiful-grid-editors.css",
          "type": "registry:style",
          "target": "components/beautiful-grid/beautiful-grid-editors.css"
        }
      ]
    }
  ]
}
